{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coding-plan-comparison schema",
  "description": "Schema for public/data/latest.json — credit/token-pass subscriptions with base credits (token prices), cache model and workload profile.",
  "type": "object",
  "required": ["meta", "plans"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["snapshot"],
      "properties": {
        "snapshot": { "type": "string", "format": "date" },
        "basis": { "type": "string" }
      }
    },
    "plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/plan" }
    }
  },
  "$defs": {
    "price": {
      "type": "object",
      "required": ["monthlyUsd"],
      "properties": {
        "monthlyUsd": { "type": ["number", "null"] },
        "paidPrice": { "type": ["number", "null"], "description": "Paid checkout price; can differ from the advertised price" },
        "advertisedPrice": { "type": ["number", "null"] },
        "billingNote": { "type": "string" },
        "altPrice": { "type": ["string", "null"], "description": "Second currency, e.g. '¥39/mo'" }
      }
    },
    "quota": {
      "type": "object",
      "required": ["label", "unit", "amount", "window", "refresh"],
      "properties": {
        "label": { "type": "string" },
        "unit": { "enum": ["usd", "credits", "requests", "prompts", "messages", "calls", "tasks", "gpu_hours"] },
        "amount": { "type": ["number", "string", "null"] },
        "window": { "enum": ["5h", "day", "week", "month", "rolling", "dynamic", "concurrent"] },
        "refresh": { "enum": ["rolling", "weekly", "monthly", "daily", "task_done", "contract", "dynamic"] },
        "shared": { "type": ["boolean", "string"] },
        "disclosure": { "enum": ["exact", "approximate", "undisclosed"] }
      }
    },
    "tokenPricing": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "note": { "type": "string" },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "input": { "type": ["number", "null"] },
              "output": { "type": ["number", "null"] },
              "cachedRead": { "type": ["number", "null"] },
              "cachedWrite": { "type": ["number", "null"] },
              "multiplier": { "type": ["number", "null"] },
              "usage": { "type": ["number", "null"], "description": "Plan-owned credits/month for this model (OpenCode Go)" },
              "allowances": { "type": "object", "description": "Plan-specific allowances (Command Code)" },
              "pattern": { "type": "object", "properties": { "input": { "type": "number" }, "cachedRead": { "type": "number" }, "output": { "type": "number" } } }
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "pattern": { "type": "object", "properties": { "input": { "type": "number" }, "cachedRead": { "type": "number" }, "output": { "type": "number" } } },
        "taskConversion": { "type": ["string", "null"], "description": "Provider-owned conversion, e.g. '10,000 inference calls ≈ 1,000 user requests'" }
      }
    },
    "providerCost": {
      "type": "object",
      "description": "Provider-owned credit formula (e.g. GLM). Formula: creditsPerRequest = (input×c_input + cachedRead×c_cached + output×c_output)/10000 applied to the pattern.",
      "properties": {
        "formula": { "type": "string", "description": "Human-readable formula description" },
        "perModel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "input", "cachedRead", "output"],
            "properties": {
              "model": { "type": "string" },
              "input": { "type": "number" },
              "cachedRead": { "type": "number" },
              "output": { "type": "number" }
            }
          }
        },
        "mcpPerCall": { "type": ["number", "null"], "description": "Credits per MCP tool call (if the provider bills separately)" },
        "offPeakDiscount": { "type": ["number", "null"], "description": "Off-peak discount as a factor (e.g. 0.5 = 50% off)" },
        "note": { "type": "string" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["id", "provider", "name", "price", "meter", "quotas", "disclosure", "sourceIds", "verifiedAt"],
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "price": { "$ref": "#/$defs/price" },
        "meter": { "enum": ["dollar_usage", "credits", "requests", "prompts", "messages", "inference_calls", "gpu", "allowance"] },
        "quotas": { "type": "array", "items": { "$ref": "#/$defs/quota" } },
        "tokenPricing": { "$ref": "#/$defs/tokenPricing" },
        "workload": { "$ref": "#/$defs/workload" },
        "throughput": { "type": "object", "properties": { "concurrency": { "type": ["number", "null"] }, "rpm": { "type": ["number", "null"] }, "notes": { "type": "string" } } },
        "models": { "type": "array", "items": { "type": "string" } },
        "disclosure": { "enum": ["disclosed", "undisclosed", "partial"] },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "verifiedAt": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
